}%

\glsdefs@newdocentry{intrinsic ethics}%
{%
name={éthique intrinsèque},%
sort={éthique intrinsèque},%
type={main},%
first={éthique intrinsèque},%
firstplural={éthique intrinsèques},%
text={éthique intrinsèque},%
plural={éthique intrinsèques},%
description={Valeurs personnelles qui sont incorporées dans le travail de recherche, de manière consciente ou non. \cite {tuana_leading_2010} la définit ainsi : \enquote {ethical issues and values that are embedded in or otherwise internal to the production of scientific research and analysis. These involve ethical issues arising from, for example: the choice of certain equations, constants, and variables; analysis of data; handling of error, and degree of confidence in projections.}},%
descriptionplural={Valeurs personnelles qui sont incorporées dans le travail de recherche, de manière consciente ou non. \cite {tuana_leading_2010} la définit ainsi : \enquote {ethical issues and values that are embedded in or otherwise internal to the production of scientific research and analysis. These involve ethical issues arising from, for example: the choice of certain equations, constants, and variables; analysis of data; handling of error, and degree of confidence in projections.}},%
symbol={\relax },%
symbolplural={\relax },%
user1={},%
