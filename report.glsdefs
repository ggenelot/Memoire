text={éthique procédurale},%
plural={éthique procédurales},%
description={Respect des lignes conductrices et des usages dans un travail de recherche. Correspond à ce que l'on appelle communément de la \textit {bonne recherche} (good science). \cite {tuana_leading_2010} la définit ainsi : \enquote {ethical aspects of the process of conducting scientific research, such as: falsification, fabrication, and plagiarism; care for subjects (human and non-human animal); responsible authorship issues; analysis of and care for data}.},%
descriptionplural={Respect des lignes conductrices et des usages dans un travail de recherche. Correspond à ce que l'on appelle communément de la \textit {bonne recherche} (good science). \cite {tuana_leading_2010} la définit ainsi : \enquote {ethical aspects of the process of conducting scientific research, such as: falsification, fabrication, and plagiarism; care for subjects (human and non-human animal); responsible authorship issues; analysis of and care for data}.},%
symbol={\relax },%
symbolplural={\relax },%
user1={},%
